# Qt for OpenHarmony 下载信息
# ============================================================================
# 本文件是 Qt 二进制包的"单一信息源",Dockerfile 构建时 COPY 并 source。
# 升级 Qt 版本时,只改本文件即可,无需改 Dockerfile 或配 secret。
#
# 包结构(两层压缩,Dockerfile 自动处理):
#   外层 .zip  →  解压得到一个 .tar.gz(Qt5.15.17_OHOS18_<arch>_linux_*.tar.gz)
#   内层 .tar.gz  →  解压直接得到 bin/ lib/ mkspecs/ ...(无顶层包装目录)
#   最终落到 /opt/qt/<arch>/{bin,lib,...}
#
# 校验值类型:SHA256(用 sha256sum 生成,用于下载完整性校验)
#   sha256sum ubuntu-22.04-output-qt5.15.17-x86-64-18-release.zip
# ============================================================================

QT_VERSION="5.15.17_OHOS18"

# x86_64 架构
QT_X86_URL="https://gitcode.com/openharmony-sig/qt/releases/download/Alpha_v9/ubuntu-22.04-output-qt5.15.17-x86-64-18-release.zip"
QT_X86_SHA256="e47f134249e8dc6be635c335c6b2412ad9d30cd62005ca7f77f6995e90129375"

# arm64-v8a 架构
QT_ARM64_URL="https://gitcode.com/openharmony-sig/qt/releases/download/Alpha_v9/ubuntu-22.04-output-qt5.15.17-arm64-v8a-18-release.zip"
QT_ARM64_SHA256="9f24b91d491b0f395c710486f36233539dd9572fb3641772c3ab3e75ea97a521"
